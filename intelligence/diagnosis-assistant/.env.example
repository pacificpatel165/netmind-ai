# NetMind AI -- component #7, diagnosis assistant
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` itself is gitignored -- never commit real API keys.
#
# LLM_PROVIDER selects the backend: ollama (default if unset/blank),
# groq, or gemini. Only the key for whichever provider you're using
# actually needs a real value.

LLM_PROVIDER=ollama

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides -- sensible defaults are already set in code if
# these are left blank/unset:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-2.5-flash   # alternative -- also Stable
